<Window x:Class="ApiTestFramework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApiTestFramework"
        xmlns:vm="clr-namespace:ApiTestFramework.ViewModels"
        xmlns:converters="clr-namespace:ApiTestFramework.Converters"
        xmlns:models="clr-namespace:ApiTestFramework.Models"
        mc:Ignorable="d"
        Title="ApiTestFramework - 接口测试工具" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:RequestVerbToColorConverter x:Key="VerbColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StatusCodeToColorConverter x:Key="StatusCodeColorConverter"/>

        <HierarchicalDataTemplate DataType="{x:Type models:RequestFolder}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁" Margin="0,0,5,0" FontSize="14"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:RequestItemNode}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding RequestVerb}" 
                           Foreground="{Binding RequestVerb, Converter={StaticResource VerbColorConverter}}"
                           FontWeight="Bold"
                           Width="50"
                           Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:SeedDataNode}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌱" Margin="0,0,5,0" FontSize="14"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D2D" Padding="10,8">
            <Grid>
                <TextBlock Text="ApiTestFramework" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="⚙ 设置" 
                        Click="Settings_Click"
                        HorizontalAlignment="Right"
                        Background="#3D3D3D"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,8"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8E8E8" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新建文件夹" 
                                    Command="{Binding TreeViewModel.AddFolderCommand}"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="#CCC"
                                    Padding="8,4"
                                    Margin="0,0,5,0"/>
                            <Button Content="新建请求" 
                                    Command="{Binding TreeViewModel.AddRequestCommand}"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="#CCC"
                                    Padding="8,4"
                                    Margin="0,0,5,0"/>
                            <Button Content="新增种子数据" 
                                    Command="{Binding TreeViewModel.AddSeedDataCommand}"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="#CCC"
                                    Padding="8,4"/>
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="RequestTreeView"
                              Grid.Row="1" 
                              ItemsSource="{Binding TreeViewModel.Nodes}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              ContextMenuOpening="TreeView_ContextMenuOpening"
                              Background="Transparent"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="5,3"/>
                                <Setter Property="Margin" Value="2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="TreeContextMenu" />
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDD"/>

            <ContentControl Grid.Column="2" Content="{Binding CurrentDetailView}"/>
        </Grid>
    </Grid>
</Window>
