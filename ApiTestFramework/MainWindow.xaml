<Window x:Class="ApiTestFramework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApiTestFramework"
        xmlns:vm="clr-namespace:ApiTestFramework.ViewModels"
        xmlns:converters="clr-namespace:ApiTestFramework.Converters"
        xmlns:models="clr-namespace:ApiTestFramework.Models"
        mc:Ignorable="d"
        Title="ApiTestFramework - 接口测试工具" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:RequestVerbToColorConverter x:Key="VerbColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <HierarchicalDataTemplate DataType="{x:Type models:RequestFolder}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁" Margin="0,0,5,0" FontSize="14"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:RequestItemNode}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding RequestVerb}" 
                           Foreground="{Binding RequestVerb, Converter={StaticResource VerbColorConverter}}"
                           FontWeight="Bold"
                           Width="50"
                           Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D2D" Padding="10,8">
            <Grid>
                <TextBlock Text="ApiTestFramework" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="⚙ 设置" 
                        Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Right"
                        Background="#3D3D3D"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,8"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8E8E8" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新建文件夹" 
                                    Command="{Binding TreeViewModel.AddFolderCommand}"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="#CCC"
                                    Padding="8,4"
                                    Margin="0,0,5,0"/>
                            <Button Content="新建请求" 
                                    Command="{Binding TreeViewModel.AddRequestCommand}"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="#CCC"
                                    Padding="8,4"/>
                        </StackPanel>
                    </Border>

                    <TreeView Grid.Row="1" 
                              ItemsSource="{Binding TreeViewModel.Nodes}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Background="Transparent"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="5,3"/>
                                <Setter Property="Margin" Value="2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDD"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FAFAFA" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                                  ItemsSource="{Binding DetailViewModel.AvailableVerbs}"
                                  SelectedItem="{Binding DetailViewModel.RequestVerb}"
                                  Width="100"
                                  Margin="0,0,10,0"
                                  Padding="8,5"/>

                        <TextBox Grid.Column="1" 
                                 Text="{Binding DetailViewModel.Path, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CCC"/>

                        <Button Grid.Column="2" 
                                Content="发送" 
                                Command="{Binding DetailViewModel.SendRequestCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="20,8"
                                Margin="10,0,0,0"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Padding="0">
                    <TabItem Header="Headers">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" 
                                    Content="添加 Header" 
                                    Click="AddHeader_Click"
                                    HorizontalAlignment="Left"
                                    Margin="10"
                                    Padding="10,5"/>

                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding DetailViewModel.Headers}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Click="DeleteHeader_Click" Background="#F44336" Foreground="White" BorderThickness="0" Padding="8,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Body">
                        <TextBox Text="{Binding DetailViewModel.Body, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="10"
                                 BorderThickness="0"/>
                    </TabItem>

                    <TabItem Header="响应">
                        <TextBox Text="{Binding DetailViewModel.Response}"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="10"
                                 BorderThickness="0"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" 
                    Width="500" 
                    Height="400" 
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D2D" Padding="15,10" CornerRadius="8,8,0,0">
                        <TextBlock Text="全局设置" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <TabControl Grid.Row="1" Padding="10">
                        <TabItem Header="Token">
                            <TextBox Text="{Binding SettingsViewModel.Token, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"
                                     Margin="0,10,0,0"
                                     VerticalContentAlignment="Center"/>
                        </TabItem>

                        <TabItem Header="全局变量">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Content="添加变量" Click="AddVariable_Click" HorizontalAlignment="Left" Margin="0,10" Padding="10,5"/>

                                <DataGrid Grid.Row="1" 
                                          ItemsSource="{Binding SettingsViewModel.GlobalVariables}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="变量名" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="变量值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="删除" Click="DeleteVariable_Click" Background="#F44336" Foreground="White" BorderThickness="0" Padding="8,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="取消" 
                                Command="{Binding CloseSettingsCommand}"
                                Padding="15,8"
                                Margin="0,0,10,0"/>
                        <Button Content="保存" 
                                Command="{Binding SaveSettingsCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
