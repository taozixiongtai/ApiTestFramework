<UserControl x:Class="ApiTestFramework.UI.Controls.RequestDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ApiTestFramework.UI"
             xmlns:vm="clr-namespace:ApiTestFramework.UI.ViewModels"
             xmlns:converters="clr-namespace:ApiTestFramework.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StatusCodeToColorConverter x:Key="StatusCodeColorConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFAFA" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1"
                Visibility="{Binding HasRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" 
                          ItemsSource="{Binding AvailableVerbs}"
                          SelectedItem="{Binding RequestVerb}"
                          Width="100"
                          Margin="0,0,10,0"
                          Padding="8,5"/>

                <TextBox Grid.Column="1" 
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CCC"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="保存" 
                            Command="{Binding DataContext.SaveRequestCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,8"
                            Margin="0,0,5,0"
                            Cursor="Hand"/>
                    <Button Content="发送" 
                            Command="{Binding SendRequestCommand}"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,8"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Padding="0"
                    Visibility="{Binding HasRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TabItem Header="Headers">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" 
                            Content="添加 Header" 
                            Click="AddHeader_Click"
                            HorizontalAlignment="Left"
                            Margin="10"
                            Padding="10,5"/>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Headers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Click="DeleteHeader_Click" Background="#F44336" Foreground="White" BorderThickness="0" Padding="8,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Body">
                <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="10"
                         BorderThickness="0"/>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" 
                      Height="8" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Center" 
                      Background="#DDD"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      Visibility="{Binding HasRequest, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                Visibility="{Binding HasRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#E8E8E8" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="响应" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0"
                                    Visibility="{Binding HasResponse, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="状态码: " VerticalAlignment="Center" Foreground="#666"/>
                            <TextBlock Text="{Binding StatusCode}" VerticalAlignment="Center" 
                                       Foreground="{Binding StatusCode, Converter={StaticResource StatusCodeColorConverter}}"
                                       FontWeight="Bold" Margin="0,0,15,0"/>
                            <TextBlock Text="耗时: " VerticalAlignment="Center" Foreground="#666"/>
                            <TextBlock Text="{Binding ResponseTime, StringFormat={}{0:F2}ms}" 
                                       VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <TextBox Grid.Row="1"
                         Text="{Binding Response}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="10"
                         BorderThickness="0"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="0" Grid.RowSpan="4"
                   Text="请选择一个请求节点"
                   FontSize="16"
                   Foreground="#999"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRequest}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
