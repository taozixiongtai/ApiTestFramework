<UserControl x:Class="ApiTestFramework.UI.Controls.WebRecorderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：导航按钮 + 地址栏 + 会话名 + 保存/清空 -->
        <Border Grid.Row="0" Background="#FAFAFA" Padding="8,5" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← 后退"
                        Command="{Binding BackCommand}"
                        Background="Transparent" BorderThickness="1" BorderBrush="#CCC"
                        Padding="8,4" Margin="0,0,5,0"/>
                <Button Grid.Column="1" Content="→ 前进"
                        Command="{Binding ForwardCommand}"
                        Background="Transparent" BorderThickness="1" BorderBrush="#CCC"
                        Padding="8,4" Margin="0,0,5,0"/>
                <Button Grid.Column="2" Content="⟳ 刷新"
                        Command="{Binding RefreshCommand}"
                        Background="Transparent" BorderThickness="1" BorderBrush="#CCC"
                        Padding="8,4" Margin="0,0,0,0"/>

                <TextBox Grid.Column="3"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" Margin="5,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CCC">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding NavigateCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="4" Content="转到"
                        Command="{Binding NavigateCommand}"
                        Background="Transparent" BorderThickness="1" BorderBrush="#CCC"
                        Padding="10,4" Margin="0,0,5,0"/>

                <Separator Grid.Column="5" Margin="5,0" Background="#CCC"/>

                <TextBox Grid.Column="6"
                         Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}"
                         Width="160"
                         Padding="6,4" Margin="5,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CCC"/>

                <Button Grid.Column="7" Content="保存为请求文件夹"
                        Command="{Binding SaveCommand}"
                        Background="#2196F3" Foreground="White"
                        BorderThickness="0" FontWeight="Bold"
                        Padding="12,4" Margin="0,0,5,0"
                        Cursor="Hand"/>

                <Button Grid.Column="8" Content="清空"
                        Command="{Binding ClearCommand}"
                        Background="Transparent" BorderThickness="1" BorderBrush="#CCC"
                        Padding="8,4"/>
            </Grid>
        </Border>

        <!-- 浏览器 + 分隔条 + 捕获列表 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="WebBrowser" Grid.Column="0"/>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#DDD"/>

            <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="捕获的请求 (fetch/XHR，双击查看详情)"
                               FontWeight="Bold" FontSize="13"
                               Margin="6,6,6,4"/>

                    <ListView x:Name="CapturedListView"
                              ItemsSource="{Binding CapturedItems}"
                              BorderThickness="0" Background="Transparent"
                              MouseDoubleClick="CapturedList_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="30" DisplayMemberBinding="{Binding Order}"/>
                                <GridViewColumn Header="方法" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Method}" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="45" DisplayMemberBinding="{Binding StatusCodeText}"/>
                                <GridViewColumn Header="URL" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="Red"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusCode}" Value="0">
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusCode}" Value="200">
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
