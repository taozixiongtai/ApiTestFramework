<UserControl x:Class="ApiTestFramework.UI.Controls.SeedDataDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ApiTestFramework.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFAFA" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加文件"
                        Command="{Binding AddFileCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,8"
                        Margin="0,0,5,0"
                        Cursor="Hand"/>
                <Button Content="执行全部"
                        Command="{Binding ExecuteAllCommand}"
                        Background="#FF9800"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,8"
                        Cursor="Hand"/>
                <ProgressBar Width="20"
                             Height="20"
                             Margin="10,0,0,0"
                             IsIndeterminate="{Binding IsExecuting}"
                             Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding SeedFiles}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" 
                                    Binding="{Binding FileName}" 
                                    Width="*"/>
                <DataGridTextColumn Header="上传时间" 
                                    Binding="{Binding UploadTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                    Width="180"/>
                <DataGridTextColumn Header="文件大小" 
                                    Binding="{Binding FileSizeDisplay}" 
                                    Width="100"/>
                <DataGridTemplateColumn Header="操作" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="修改" 
                                        Command="{Binding DataContext.EditFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#00BCD4"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,5"
                                        Margin="0,0,5,0"
                                        Cursor="Hand"/>
                                <Button Content="删除" 
                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#F44336"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,5"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#E8E8E8" Padding="10,5" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding ResultMessage}" Foreground="#666" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
