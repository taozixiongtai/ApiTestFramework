<UserControl x:Class="ApiTestFramework.UI.Controls.ReplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部信息区：会话名 + 执行复现按钮 -->
        <Border Grid.Row="0" Background="#FAFAFA" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="录制会话：" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SessionName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,15,0"/>
                    <TextBlock Text="双击结果行查看请求详情" FontSize="11" Foreground="#999" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="执行复现"
                        Command="{Binding ExecuteReplayCommand}"
                        Background="#4CAF50" Foreground="White"
                        BorderThickness="0" Padding="15,8"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 复现结果列表 -->
        <ListView x:Name="ResultListView" Grid.Row="1" ItemsSource="{Binding Results}"
                  BorderThickness="0" Background="White"
                  MouseDoubleClick="ResultList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="35" DisplayMemberBinding="{Binding Order}"/>
                    <GridViewColumn Header="方法" Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Method}" FontWeight="Bold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="状态码" Width="55" DisplayMemberBinding="{Binding StatusCodeText}"/>
                    <GridViewColumn Header="耗时ms" Width="60" DisplayMemberBinding="{Binding ElapsedMs, StringFormat={}{0:F0}}"/>
                    <GridViewColumn Header="URL" Width="320">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="错误" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorMessage}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- 底部汇总 -->
        <Border Grid.Row="2" Background="#E8E8E8" Padding="10,5" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Summary}" FontWeight="Bold" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
