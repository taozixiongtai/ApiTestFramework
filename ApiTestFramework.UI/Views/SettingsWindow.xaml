<Window x:Class="ApiTestFramework.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="全局设置" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D2D" Padding="15,10">
            <TextBlock Text="全局设置" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="1" Padding="10">
            <TabItem Header="基础配置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,10,0,0">
                        <TextBlock Text="基础 URL" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <TextBlock Text="认证 Token" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="全局变量">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" 
                            Content="添加变量" 
                            Click="AddVariable_Click" 
                            HorizontalAlignment="Left" 
                            Margin="0,10" 
                            Padding="10,5"/>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding GlobalVariables}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="变量名" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="变量值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" 
                                                Click="DeleteVariable_Click" 
                                                Background="#F44336" 
                                                Foreground="White" 
                                                BorderThickness="0" 
                                                Padding="8,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="全局请求头">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" 
                            Content="添加请求头" 
                            Click="AddHeader_Click" 
                            HorizontalAlignment="Left" 
                            Margin="0,10" 
                            Padding="10,5"/>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding GlobalHeaders}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Header 名称" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Header 值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" 
                                                Click="DeleteHeader_Click" 
                                                Background="#F44336" 
                                                Foreground="White" 
                                                BorderThickness="0" 
                                                Padding="8,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="取消" 
                    Click="Cancel_Click"
                    Padding="15,8"
                    Margin="0,0,10,0"/>
            <Button Content="保存" 
                    Click="Save_Click"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
